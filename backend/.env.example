# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.
# Loaded automatically when the server starts from the backend folder.
# Write values without quotes. Real environment variables override this file.

# Gemini API key, needed only when EXTRACTOR_TYPE=llm.
LLM_API_KEY=

# fixture returns the kit's canned answers and needs no key. llm calls the vision model.
EXTRACTOR_TYPE=fixture

# Any vision-capable Gemini model.
LLM_MODEL=gemini-3.1-flash-lite
